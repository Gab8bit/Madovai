# Copia in .env e modifica. Tutto facoltativo: i default vanno bene per provare.

# Porta interna del container (quella esterna si sceglie nel docker-compose).
PORT=3000
# Cartella dati dentro il container (database GTFS, promemoria, chiavi VAPID). Montata su un volume.
DATA_DIR=/data

# Origini ammesse per le chiamate dal browser, separate da virgole, oppure * (le app native non mandano Origin).
CORS_ORIGINS=*
# Richieste al minuto per IP verso /api.
RATE_LIMIT_PER_MINUTE=300

# Ricostruzione quotidiana dei dati GTFS, ora di Roma (vuoto = mai; al primo avvio viene comunque costruito).
GTFS_REBUILD_AT=04:30
# Scheduler dei promemoria (ogni minuto) dentro il processo.
REMINDERS_ENABLED=true

# --- Notifiche ---
# Web Push: contatto inviato ai servizi push (mailto: o https:). Le chiavi VAPID si generano da sole al primo avvio.
VAPID_SUBJECT=mailto:admin@example.com

# FCM (Android): percorso, DENTRO il container, del JSON del service account Firebase
# (Console Firebase → Impostazioni progetto → Account di servizio → Genera nuova chiave privata). Vuoto = FCM spento.
FCM_SERVICE_ACCOUNT_FILE=

# APNs (iOS nativo): richiede l'Apple Developer Program a pagamento. Vuoti = APNs spento.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false
