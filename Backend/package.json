{
  "name": "madovai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Madovai backend: Cotral, ASTRAL and Atac/Roma TPL live data + reminders/push for web, Android and iOS clients",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "build-data": "node dist/cli/build-data.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "gtfs-realtime-bindings": "^2.2.0",
    "jose": "^6.2.15",
    "undici": "^8.12.4",
    "web-push": "^4.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
