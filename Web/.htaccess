# Madovai Web — project root. Use this when the whole project is uploaded into a subfolder of an existing site
# (e.g. /var/www/html/madovai) instead of pointing the DocumentRoot at public/.
# Every request is served from public/, so src/, data/, bin/, docs/, tests/ and config.php are NOT reachable over HTTP.
# Needs: mod_rewrite + "AllowOverride All" for this folder.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !(^|/)public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
Options -Indexes
