# Madovai Web — Apache config for the public folder (DocumentRoot, or a subfolder of an existing site).

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The service worker must always be revalidated so app updates reach installed PWAs.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </Files>
  # Code and pages: ALWAYS revalidate with the server (a 304 is a few hundred bytes). A fixed max-age here used to
  # leave visitors on an old, buggy app for up to an hour after an update.
  <FilesMatch "\.(html|webmanifest|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# JSON API: PHP endpoints are plain files (api/foo.php); never let a directory listing leak.
Options -Indexes
DirectoryIndex index.html
